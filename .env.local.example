# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://anxetjhccpjbkdwlxtwz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Discogs
# Generate a personal access token at https://www.discogs.com/settings/developers
# (used server-side for marketplace stats + condition-graded price suggestions).
DISCOGS_PERSONAL_ACCESS_TOKEN=your-discogs-personal-access-token
DISCOGS_USER_AGENT=VinylVault/1.0

# eBay (sandbox)
EBAY_CLIENT_ID=your-ebay-sandbox-client-id
EBAY_CLIENT_SECRET=your-ebay-sandbox-client-secret
# eBay calls this "Your auth accepted URL" / RuName in the Developer portal.
# Important: this is NOT http://localhost:3000/api/ebay/callback.
EBAY_RU_NAME=your-ebay-sandbox-runame
EBAY_REDIRECT_URI=http://localhost:3000/api/ebay/callback
EBAY_ENVIRONMENT=sandbox

# Encryption key for storing eBay tokens (required for production OAuth)
TOKEN_ENCRYPTION_KEY=32-char-random-string-here!!

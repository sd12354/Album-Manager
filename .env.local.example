# ============================================================
# VinylVault — environment configuration
# ============================================================
# Copy this file to `.env.local` for local development and set
# the same values in Vercel's "Environment Variables" panel for
# production. See README.md → "Deploy to Vercel" for details.

# ============================================================
# Supabase (REQUIRED)
# ============================================================
# Found at Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# App URL (REQUIRED)
# ============================================================
# Used for OAuth redirects and email links.
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app  (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# Cloudflare R2 photo storage (OPTIONAL — recommended)
# ============================================================
# Album photos are stored at full quality. Supabase's free plan only includes
# 1 GB of storage; Cloudflare R2's free tier includes 10 GB with free egress.
# When ALL five values below are set, new photos upload to R2. If any is
# missing the app keeps using Supabase Storage exactly as before.
#
# Setup: Cloudflare dashboard → R2 → create a bucket → Settings → enable the
# Public Development URL (or connect a custom domain) → add a CORS policy
# allowing GET, HEAD and PUT from your app's origin with the headers
# content-type and cache-control. Then R2 → Manage API tokens → create a token
# with "Object Read & Write" limited to that bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL photos are served from, no trailing slash,
# e.g. https://pub-xxxxxxxx.r2.dev or https://photos.yourdomain.com
R2_PUBLIC_URL=
# Optional: full S3 endpoint host, only for jurisdiction-specific buckets
# (e.g. <account-id>.eu.r2.cloudflarestorage.com). Overrides R2_ACCOUNT_ID.
R2_ENDPOINT=

# ============================================================
# Downtime page (OPTIONAL)
# ============================================================
# Set MAINTENANCE_MODE=1 and redeploy to show every visitor a "we're doing
# some work" page; remove it and redeploy to bring the site back. The same
# page appears automatically if Supabase is unreachable, paused or restricted.
MAINTENANCE_MODE=
# Optional extra line shown on the page, e.g. "Back by 6pm Eastern."
MAINTENANCE_MESSAGE=
# Comma-separated accounts that keep full access during maintenance. Sign in
# at /login?staff while the page is up.
MAINTENANCE_ALLOW_EMAILS=
# Optional contact address shown on the downtime page.
SUPPORT_EMAIL=
# Optional: if set, /api/keepalive (the daily Vercel cron that stops Supabase's
# free plan pausing the project) only answers Vercel's own cron requests.
CRON_SECRET=

# ============================================================
# Discogs (RECOMMENDED — powers pricing & listings)
# ============================================================
# Preferred: OAuth so users click "Connect Discogs Account" and log in
# instead of pasting a token. Register an app at
# https://www.discogs.com/settings/developers → "Create an Application"
# and copy its Consumer Key/Secret. Set the app's callback URL to
# <NEXT_PUBLIC_APP_URL>/api/discogs/callback.
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
# Optional override. Leave blank unless your deployed callback host differs
# from the request host. If set, it must exactly match the Discogs app callback.
DISCOGS_CALLBACK_URL=
#
# Optional fallback: a server-wide Personal Access Token (used when a user
# hasn't connected via OAuth). Generate at the same page under
# "Personal access token". Without any Discogs auth, pricing falls back to
# eBay only (which may be empty in sandbox mode).
DISCOGS_PERSONAL_ACCESS_TOKEN=
DISCOGS_USER_AGENT=VinylVault/1.0

# ============================================================
# eBay (OPTIONAL — needed for live pricing comparables + listing)
# ============================================================
# Get keys at https://developer.ebay.com/my/keys
#   • Sandbox keys return fake/empty data — fine for testing OAuth flow
#   • Production keys return real comparables (no eBay approval needed
#     for Browse API; just standard developer account)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# eBay's "RuName" is what you paste as the redirect target in their
# Developer portal under "User Tokens" → "Get a Token from eBay via
# Your Application". It is NOT the literal callback URL.
EBAY_RU_NAME=
EBAY_REDIRECT_URI=http://localhost:3000/api/ebay/callback
# Required by eBay for production keysets under Alerts & Notifications →
# Marketplace Account Deletion.
EBAY_ACCOUNT_DELETION_ENDPOINT_URL=http://localhost:3000/api/ebay/account-deletion
EBAY_ACCOUNT_DELETION_VERIFICATION_TOKEN=
# Set to "production" to use real eBay APIs, "sandbox" for testing.
EBAY_ENVIRONMENT=sandbox

# ============================================================
# Shippo (OPTIONAL — auto-generates prepaid shipping labels)
# ============================================================
# One-click OAuth connect (mirrors eBay/Discogs). Register a Shippo OAuth
# app to obtain these and whitelist <APP_URL>/api/shippo/callback as the
# redirect URI. Without these, users can still paste an API key in Settings.
SHIPPO_CLIENT_ID=
SHIPPO_CLIENT_SECRET=
# Optional override. Leave blank unless the deployed callback host differs
# from the request host. Must exactly match the Shippo app redirect URI.
SHIPPO_CALLBACK_URL=
# Optional server-wide API key fallback (used when a user hasn't connected
# their own account). Get one at https://app.goshippo.com/user/apikeys
SHIPPO_API_KEY=

# ============================================================
# Token encryption (REQUIRED for production eBay OAuth)
# ============================================================
# Must be exactly 32 characters. Generate with:
#   openssl rand -base64 32 | head -c 32
TOKEN_ENCRYPTION_KEY=

# ============================================================
# Anthropic (OPTIONAL — enables AI pricing & listing descriptions)
# ============================================================
# Get a key at https://console.anthropic.com/settings/keys
# Without this, the AI price-analysis and description buttons return a
# "not configured" error. The variable name must match EXACTLY.
# On Vercel: add it under Project → Settings → Environment Variables for
# the Production environment, then trigger a fresh redeploy.
ANTHROPIC_API_KEY=
# Optional override for cover-photo OCR/visual matching.
# Defaults to claude-opus-4-5.
ANTHROPIC_VISION_MODEL=

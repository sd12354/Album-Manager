# ============================================================
# VinylVault — environment configuration
# ============================================================
# Copy this file to `.env.local` for local development and set
# the same values in Vercel's "Environment Variables" panel for
# production. See README.md → "Deploy to Vercel" for details.

# ============================================================
# Supabase (REQUIRED)
# ============================================================
# Found at Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# App URL (REQUIRED)
# ============================================================
# Used for OAuth redirects and email links.
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app  (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# Discogs (RECOMMENDED — powers pricing & listings)
# ============================================================
# Preferred: OAuth so users click "Connect Discogs Account" and log in
# instead of pasting a token. Register an app at
# https://www.discogs.com/settings/developers → "Create an Application"
# and copy its Consumer Key/Secret. Set the app's callback URL to
# <NEXT_PUBLIC_APP_URL>/api/discogs/callback.
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
#
# Optional fallback: a server-wide Personal Access Token (used when a user
# hasn't connected via OAuth). Generate at the same page under
# "Personal access token". Without any Discogs auth, pricing falls back to
# eBay only (which may be empty in sandbox mode).
DISCOGS_PERSONAL_ACCESS_TOKEN=
DISCOGS_USER_AGENT=VinylVault/1.0

# ============================================================
# eBay (OPTIONAL — needed for live pricing comparables + listing)
# ============================================================
# Get keys at https://developer.ebay.com/my/keys
#   • Sandbox keys return fake/empty data — fine for testing OAuth flow
#   • Production keys return real comparables (no eBay approval needed
#     for Browse API; just standard developer account)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# eBay's "RuName" is what you paste as the redirect target in their
# Developer portal under "User Tokens" → "Get a Token from eBay via
# Your Application". It is NOT the literal callback URL.
EBAY_RU_NAME=
EBAY_REDIRECT_URI=http://localhost:3000/api/ebay/callback
# Required by eBay for production keysets under Alerts & Notifications →
# Marketplace Account Deletion.
EBAY_ACCOUNT_DELETION_ENDPOINT_URL=http://localhost:3000/api/ebay/account-deletion
EBAY_ACCOUNT_DELETION_VERIFICATION_TOKEN=
# Set to "production" to use real eBay APIs, "sandbox" for testing.
EBAY_ENVIRONMENT=sandbox

# ============================================================
# Token encryption (REQUIRED for production eBay OAuth)
# ============================================================
# Must be exactly 32 characters. Generate with:
#   openssl rand -base64 32 | head -c 32
TOKEN_ENCRYPTION_KEY=

# ============================================================
# Anthropic (OPTIONAL — enables AI pricing & listing descriptions)
# ============================================================
# Get a key at https://console.anthropic.com/settings/keys
# Without this, the AI price-analysis and description buttons return a
# "not configured" error. The variable name must match EXACTLY.
# On Vercel: add it under Project → Settings → Environment Variables for
# the Production environment, then trigger a fresh redeploy.
ANTHROPIC_API_KEY=
